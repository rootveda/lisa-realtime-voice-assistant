# Copy to lisa_admin_token.env and set your token.
#   cp offline_setup/lisa_admin_token.env.example offline_setup/lisa_admin_token.env
#
# Run from lisa/nvidia_voice (NOT offline_setup/app):
#   ./offline_setup/lisa_stack.sh start --admin
#   ./offline_setup/lisa_stack.sh start --admin --network-proxy   # + nginx on :8088
#
# Home dev (no token, localhost only): ./offline_setup/lisa_stack.sh start
#
# Docs: docs/admin-token-and-security.md  docs/stack-start-stop.md  docs/network-proxy.md
#
# --- LAN + admin auth (recommended for phones / other PCs on LAN) ---

export LISA_BIND_PUBLIC=1
export LISA_BIND_LOOPBACK_ONLY=0
export USE_LOCAL_LLAMA_PRIMARY=1
export LISA_ADMIN_TOKEN=REPLACE_WITH_openssl_rand_hex_24

# --- Optional ---

# Context stress test button in Assistant Console (Workspace configuration)
# export ENABLE_CONTEXT_STRESS_RUN_API=1

# Required for stress run POST from non-loopback clients
# export CONTEXT_STRESS_RUN_TOKEN=REPLACE_WITH_SECRET

# --- Simpler home-dev mode (same machine only, no admin token) ---
# Uncomment and use INSTEAD of the block above:
# unset LISA_BIND_PUBLIC LISA_ADMIN_TOKEN
# export LISA_BIND_LOOPBACK_ONLY=1
