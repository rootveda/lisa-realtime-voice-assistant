{
  "schema_version": 2,
  "documentation": "Vision trigger patterns (Python regex, case-insensitive). Set VISION_INTENTS_FILE to override this file. v2 (2026-05): tightened primary_regex to drop the bare \\b(see|seeing|picture|image|objects)\\b alternation that fired on phrases like 'I see what you mean'.",
  "primary_regex": "(what\\s+do\\s+you\\s+see|what\\s+\\w+(?:\\s+\\w+){0,5}\\s+see|can\\s+you\\s+see|do\\s+you\\s+see|look\\s+at\\s+(?:the\\s+)?(?:camera|picture|image|frame|view|scene|me)|look\\s+around|show\\s+me|point\\s+to\\s+the\\s+camera|describe\\s+(the\\s+)?(room|scene|environment|surroundings|view|picture)|what(?:'s|\\s+is)\\s+(that|this|there|on\\s+(the\\s+)?(screen|desk|table))|\\b(camera|webcam)\\b|(?:^|[\\s,])(picture|image|frame)\\b\\s+(?:above|below|here|please|now|right\\s+now)|what\\s+(?:are\\s+we\\s+doing|we\\s+are\\s+doing)\\??|what\\s+is\\s+(?:going\\s+on|happening)\\??(?:\\s+here)?|check\\s+the\\s+camera|can\\s+you\\s+check\\s+(?:the\\s+)?(?:camera|feed|view)|(?:can\\s+you|could\\s+you)\\s+check\\b[\\s\\S]{0,160}?\\bdoing\\b)",
  "detail_followup_regex": "(^|\\b)(eyes?\\s*(open|closed|shut)?|eye\\s+contact|blink(s|ing)?|gaze|squint|wink|\\b(open|closed)\\s+or\\s+(not|open|closed)\\b|open\\s+or\\s+not|closed\\s+or\\s+open|^now\\??$|^again\\??$|^try\\s+again\\.?$|what\\s+about\\s+now|how\\s+about\\s+now|right\\s+now|at\\s+this\\s+moment|my\\s+(face|expression)|am\\s+i\\s+(smiling|frowning|blinking)|can\\s+you\\s+tell.*\\b(eyes|face)\\b|\\b(face|mouth|nose|beard|hair|glasses|hat)\\b.*\\b(visible|see|look)\\b)",
  "refresh_regex": "(check\\s+(that|it)\\s+again|can\\s+you\\s+check(?:\\s+that|\\s+it)?\\s+again|look\\s+again|look\\s+once\\s+more|take\\s+another\\s+look|another\\s+look|one\\s+more\\s+look|verify\\s+again|double[-\\s]?check|re[-\\s]?check|refresh\\s+(the\\s+)?(view|camera|feed|picture)|^what\\s+about\\s+now\\??$|^and\\s+now\\??$)",
  "color_probe_regex": "(\\bany\\b.*\\b(green|red|blue|yellow|purple|orange|pink|white|black|brown|teal|cyan|grey|gray)\\b|\\b(green|red|blue|yellow|purple|orange|pink|white|black|brown|teal|cyan|grey|gray)\\s+colou?r\\b|\\b(is\\s+there|are\\s+there|is\\s+it|are\\s+they)\\b.*\\b(green|red|blue|yellow|purple|orange|pink|white|black)\\b|\\b(do\\s+you\\s+see|can\\s+you\\s+see|can\\s+i\\s+check)\\b.*\\b(green|red|blue|yellow|colou?r)\\b|\\bcheck\\s+whether\\b.*\\b(green|red|blue|colou?r)\\b|\\bwhat\\s+colou?rs?\\b|\\bwhich\\s+colou?r\\b|\\bspot\\s+any\\b.*\\b(colou?r|green|red|blue)\\b)"
}
